generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Booking {
  id        String   @id @default(cuid())
  name      String
  phone     String
  bouquet   String
  date      DateTime
  address   String
 message        String?
paymentMethod  String   @default("cod")
createdAt      DateTime @default(now())
}