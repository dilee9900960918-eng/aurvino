generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Booking {
  id            String   @id @default(cuid())
  name          String
  phone         String
  bouquet       String
price         Int @default(0)
  date          DateTime
  address       String
  message       String?
  paymentMethod String   @default("cod")
  status        String   @default("pending")
  createdAt     DateTime @default(now())
}

model Product {
  id          String   @id @default(cuid())
  name        String
  price       Int
  description String?
  imageUrl    String
  imageUrls   String[] @default([])
  category    String
  event       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}