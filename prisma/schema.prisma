generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Booking {
  id        String   @id @default(cuid())
  name      String
  phone     String
  bouquet   String
  date      DateTime
  address   String
 message        String?
paymentMethod  String   @default("cod")
createdAt      DateTime @default(now())
}
model Product {
  id          String   @id @default(cuid())
  name        String
  price       Int
  description String?
  imageUrl    String
  category    String
  event       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}